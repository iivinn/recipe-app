{
  "expo": {
    "name": "Dishcovery",
    "slug": "recipe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    
    "icon": "./app/media_used/logo.png", 
    
    "scheme": "recipeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.recipeapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#44AF16",
        
        "foregroundImage": "./app/media_used/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.recipeapp"
    },
    "web": {
      "output": "static",
      
      "favicon": "./app/media_used/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/media_used/logo.png",
          "imageWidth": 200,
          
          "resizeMode": "contain",
          
          "backgroundColor": "#44AF16",
          "dark": {
            "backgroundColor": "#44AF16"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
